// Shared Angler ERP / Angler ERP Ionic Firestore rules.
// Tenant access is granted by company ownership, an active users/{uid}.memberships entry,
// or an active companies/{companyId}/members/{uid} record. companyId alone is not authorization.
// User-level active:false remains a legacy global deactivation flag; new company-specific
// deactivation updates only the membership for that company.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() {
      return request.auth != null;
    }

    function currentUser() {
      let docPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(docPath) ? get(docPath).data : null;
    }

    function companyMemberExists(companyId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function companyMemberData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data;
    }

    function companyMemberIndexExists(companyId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/companyMembers/$(companyId + '_' + request.auth.uid));
    }

    function companyMemberIndexData(companyId) {
      return get(/databases/$(database)/documents/companyMembers/$(companyId + '_' + request.auth.uid)).data;
    }

    function isMember(companyId) {
      let user = currentUser();
      return isAuth() && user != null &&
        (!('active' in user) || user.active == true) &&
        (!('status' in user) || user.status != 'disabled') &&
        (
          isCompanyOwner(companyId) ||
          ('memberships' in user &&
            companyId in user.memberships &&
            user.memberships[companyId].active == true) ||
          (companyMemberExists(companyId) &&
            companyMemberData(companyId).active == true) ||
          (companyMemberIndexExists(companyId) &&
            companyMemberIndexData(companyId).active == true)
        );
    }

    function roleForCompany(companyId) {
      let user = currentUser();
      return user != null && isMember(companyId) ? (
        ('memberships' in user &&
         companyId in user.memberships &&
         user.memberships[companyId].active == true &&
         user.memberships[companyId].role is string)
        ? user.memberships[companyId].role
        : ((companyMemberExists(companyId) &&
            companyMemberData(companyId).active == true &&
            companyMemberData(companyId).role is string)
          ? companyMemberData(companyId).role
          : ((companyMemberIndexExists(companyId) &&
              companyMemberIndexData(companyId).active == true &&
              companyMemberIndexData(companyId).role is string)
            ? companyMemberIndexData(companyId).role
            : (isCompanyOwner(companyId) ? 'owner' : null)))
      ) : null;
    }

    function isCompanyOwner(companyId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/companies/$(companyId)) &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid;
    }

    function isAdmin(companyId) {
      return isAuth() && isMember(companyId) && (
        isCompanyOwner(companyId) ||
        roleForCompany(companyId) in ['owner', 'admin']
      );
    }

    function isOwner(companyId) {
      return isAuth() && isMember(companyId) && (
        isCompanyOwner(companyId) ||
        roleForCompany(companyId) == 'owner'
      );
    }

    function isOperator(companyId) {
      return isAuth() && isMember(companyId) &&
        roleForCompany(companyId) == 'operator';
    }

    function operatorGroupForCompany(companyId) {
      let user = currentUser();
      return user != null &&
        'memberships' in user &&
        companyId in user.memberships &&
        user.memberships[companyId].active == true &&
        user.memberships[companyId].role == 'operator'
        ? user.memberships[companyId].operatorGroup
        : null;
    }

    function operatorCanReadCollection(companyId, collectionName) {
      let group = operatorGroupForCompany(companyId);

      return
        (group == 'management' &&
          collectionName in ['clients', 'products', 'sales', 'purchases', 'suppliers', 'locations', 'stockMovements', 'counters'])
        ||
        (group == 'financial' &&
          collectionName in ['financialTransactions', 'sales', 'purchases', 'products', 'stockMovements', 'counters'])
        ||
        (group == 'budgets' &&
          collectionName in ['budgets', 'formulas', 'clients']);
    }

    function isActiveCompany(companyId) {
      return isAuth() &&
        currentUser() != null &&
        currentUser().companyId == companyId;
    }

    function canReadCollection(companyId, collectionName) {
      // Matches the original app: module availability is enforced by its UI,
      // while the rules enforce company membership for all roles.
      return isSuperAdmin() || isMember(companyId);
    }

    function canWriteCollection(companyId, collectionName) {
      return isSuperAdmin() ||
        isCompanyOwner(companyId) ||
        (
          isMember(companyId) &&
          roleForCompany(companyId) in ['owner', 'admin', 'operator']
        );
    }

    function canWriteData(companyId) {
      return isAdmin(companyId);
    }

    function canDeleteData(companyId) {
      return isAdmin(companyId) || isOwner(companyId);
    }

    function isSuperAdmin() {
      return isAuth() &&
        request.auth.token.email == 'admin@angler-erp.local';
    }

    function isAdminManagingUser(userId) {
      let user = currentUser();
      return isAuth() &&
        user != null &&
        user.companyId is string &&
        isAdmin(user.companyId) &&
        'memberships' in resource.data &&
        user.companyId in resource.data.memberships &&
        resource.data.memberships[user.companyId].active == true;
    }

    function isValidCompanyRole(companyId, role) {
      return role in ['owner', 'admin', 'manager', 'operator', 'viewer'] &&
        (role != 'owner' || isCompanyOwner(companyId));
    }

    function isAdminRevokingCompanyMembership(userId) {
      let actor = currentUser();
      let companyId = request.resource.data.accessControl.lastGrantedCompanyId;
      return isAuth() &&
        actor != null &&
        companyId is string &&
        actor.companyId == companyId &&
        isAdmin(companyId) &&
        'memberships' in resource.data &&
        companyId in resource.data.memberships &&
        resource.data.memberships[companyId].active == true &&
        resource.data.memberships[companyId].role != 'owner' &&
        request.resource.data.memberships[companyId].active == false &&
        request.resource.data.memberships[companyId].role == resource.data.memberships[companyId].role &&
        request.resource.data.memberships.diff(resource.data.memberships).affectedKeys().hasOnly([companyId]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberships', 'accessControl', 'updatedAt']);
    }

    function userMembershipAfterMatches(companyId, userId, memberData) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let userAfter = getAfter(userPath);
      return userAfter != null &&
        'memberships' in userAfter.data &&
        companyId in userAfter.data.memberships &&
        userAfter.data.memberships[companyId].active == memberData.active &&
        userAfter.data.memberships[companyId].role == memberData.role;
    }

    function isValidCompanyMemberWrite(companyId, userId) {
      return isAdmin(companyId) &&
        request.resource.data.companyId == companyId &&
        request.resource.data.userId == userId &&
        request.resource.data.active is bool &&
        isValidCompanyRole(companyId, request.resource.data.role) &&
        userMembershipAfterMatches(companyId, userId, request.resource.data);
    }

    function isValidCompanyMemberUpdate(companyId, userId) {
      return isValidCompanyMemberWrite(companyId, userId) &&
        resource.data.companyId == companyId &&
        resource.data.userId == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'active', 'modules', 'email', 'name', 'lastName', 'updatedAt'
        ]) &&
        (userId != request.auth.uid ||
          request.resource.data.role == resource.data.role ||
          isCompanyOwner(companyId)) &&
        (resource.data.role != 'owner' || isCompanyOwner(companyId));
    }

    function isAccessRequestOwnerApproval(userId) {
      let grant = request.resource.data.accessControl;
      let requestDoc = get(/databases/$(database)/documents/companyAccessRequests/$(grant.lastGrantedRequestId));
      return isAuth() &&
        grant.lastGrantedCompanyId is string &&
        grant.lastGrantedRequestId is string &&
        requestDoc.data.status == 'pending' &&
        requestDoc.data.requesterUid == userId &&
        requestDoc.data.companyId == grant.lastGrantedCompanyId &&
        isAdmin(grant.lastGrantedCompanyId) &&
        request.resource.data.memberships[grant.lastGrantedCompanyId].active == true &&
        request.resource.data.memberships[grant.lastGrantedCompanyId].accessRequestId == grant.lastGrantedRequestId &&
        isValidCompanyRole(grant.lastGrantedCompanyId, request.resource.data.memberships[grant.lastGrantedCompanyId].role) &&
        request.resource.data.memberships.diff(resource.data.memberships).affectedKeys().hasOnly([grant.lastGrantedCompanyId]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberships', 'accessControl', 'updatedAt']);
    }

    function isCompanyMembershipUpdate(userId) {
      let grant = request.resource.data.accessControl;
      return isAuth() &&
        grant.lastGrantedCompanyId is string &&
        isAdmin(grant.lastGrantedCompanyId) &&
        request.resource.data.memberships[grant.lastGrantedCompanyId].active == true &&
        isValidCompanyRole(grant.lastGrantedCompanyId, request.resource.data.memberships[grant.lastGrantedCompanyId].role) &&
        request.resource.data.memberships.diff(resource.data.memberships).affectedKeys().hasOnly([grant.lastGrantedCompanyId]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberships', 'accessControl', 'updatedAt']) &&
        (userId != request.auth.uid ||
          request.resource.data.memberships[grant.lastGrantedCompanyId].role == resource.data.memberships[grant.lastGrantedCompanyId].role ||
          isCompanyOwner(grant.lastGrantedCompanyId)) &&
        (resource.data.memberships[grant.lastGrantedCompanyId].role != 'owner' ||
          isCompanyOwner(grant.lastGrantedCompanyId));
    }

    function isAccessibilityUpdate(userId) {
      return isAuth() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessibilityPreferences']);
    }

    function isCompanySwitch() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['companyId', 'role']) &&
        request.resource.data.companyId is string &&
        isMember(request.resource.data.companyId) &&
        request.resource.data.role == roleForCompany(request.resource.data.companyId);
    }

    match /users/{userId} {
      allow get: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == userId) ||
        isAdmin(resource.data.companyId) ||
        isAdminManagingUser(userId);

      allow list: if isSuperAdmin() ||
        isAdmin(resource.data.companyId);

      allow create: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == userId && (
          request.resource.data.companyId == userId &&
          request.resource.data.role == 'owner'
        ));

      allow update: if isSuperAdmin() ||
        isAdminRevokingCompanyMembership(userId) ||
        (isAuth() && 'accessControl' in request.resource.data && isAccessRequestOwnerApproval(userId)) ||
        (isAuth() && 'accessControl' in request.resource.data && isCompanyMembershipUpdate(userId)) ||
        (isAuth() && request.auth.uid == userId && isCompanySwitch()) ||
        (isAuth() && request.auth.uid == userId && isAccessibilityUpdate(userId));

      allow delete: if isSuperAdmin() || isAdmin(resource.data.companyId);
    }

    match /companyAccessRequests/{requestId} {
      allow create: if isAuth() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId));

      allow get: if isSuperAdmin() ||
        (isAuth() && (
          request.auth.uid == resource.data.requesterUid ||
          isAdmin(resource.data.companyId)
        ));

      allow list: if isSuperAdmin() || isAdmin(resource.data.companyId) ||
        (isAuth() && request.auth.uid == resource.data.requesterUid);

      allow update: if isSuperAdmin() || isAdmin(resource.data.companyId);
      allow delete: if isSuperAdmin() || isOwner(resource.data.companyId);
    }

    match /companyMembers/{memberId} {
      allow get: if isSuperAdmin() ||
        (isAuth() && resource.data.userId == request.auth.uid) ||
        isAdmin(resource.data.companyId);
      allow list: if isSuperAdmin() || isAdmin(resource.data.companyId);
      allow create: if isSuperAdmin() ||
        (request.resource.data.companyId is string &&
          request.resource.data.userId is string &&
          isValidCompanyMemberWrite(request.resource.data.companyId, request.resource.data.userId));
      allow update: if isSuperAdmin() ||
        (resource.data.companyId is string &&
          resource.data.userId is string &&
          isValidCompanyMemberUpdate(resource.data.companyId, resource.data.userId));
      allow delete: if isSuperAdmin();
    }

    match /companies/{companyId}/members/{userId} {
      allow get: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == userId) ||
        isCompanyOwner(companyId) ||
        isAdmin(companyId);
      allow list: if isSuperAdmin() || isCompanyOwner(companyId) || isAdmin(companyId);
      allow create: if isSuperAdmin() ||
        isValidCompanyMemberWrite(companyId, userId);
      allow update: if isSuperAdmin() ||
        isValidCompanyMemberUpdate(companyId, userId);
      allow delete: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isMember(resource.data.companyId);
      allow create: if isSuperAdmin() ||
        (request.resource.data.companyId is string &&
          request.resource.data.userId == request.auth.uid &&
          isMember(request.resource.data.companyId));
    }

    match /deletionRequests/{requestId} {
      allow create: if isSuperAdmin() ||
        (isAuth() &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.companyId is string &&
          isOperator(request.resource.data.companyId) &&
          request.resource.data.collection in ['clients', 'products', 'sales', 'purchases', 'suppliers', 'locations', 'financialTransactions', 'budgets', 'formulas'] &&
          request.resource.data.documentId is string &&
          exists(/databases/$(database)/documents/$(request.resource.data.collection)/$(request.resource.data.documentId)) &&
          get(/databases/$(database)/documents/$(request.resource.data.collection)/$(request.resource.data.documentId)).data.companyId == request.resource.data.companyId);

      allow get: if isSuperAdmin() ||
        isAdmin(resource.data.companyId) ||
        isOwner(resource.data.companyId) ||
        (isAuth() &&
          resource.data.requesterUid == request.auth.uid &&
          isOperator(resource.data.companyId));

      allow list: if isSuperAdmin() ||
        (isAuth() && resource.data.requesterUid == request.auth.uid && isMember(resource.data.companyId)) ||
        isAdmin(resource.data.companyId) ||
        isOwner(resource.data.companyId);

      allow update: if isSuperAdmin() || isAdmin(resource.data.companyId) || isOwner(resource.data.companyId);
      allow delete: if isSuperAdmin() || isOwner(resource.data.companyId);
    }

    match /companies/{companyId} {
      allow read: if isSuperAdmin() || isAuth();
      allow write: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == companyId);
    }

    match /assistantChats/{chatId} {
      allow read: if canReadCollection(resource.data.companyId, 'assistantChats');
      allow update: if canWriteCollection(resource.data.companyId, 'assistantChats');
      allow delete: if isSuperAdmin() || (isAdmin(resource.data.companyId));

      allow create: if isSuperAdmin() ||
        (isAuth() &&
          request.resource.data.userId == request.auth.uid &&
          canWriteCollection(request.resource.data.companyId, 'assistantChats'));

      match /messages/{messageId} {
        allow read: if canReadCollection(get(/databases/$(database)/documents/assistantChats/$(chatId)).data.companyId, 'assistantChats');
        allow create, update: if canWriteCollection(get(/databases/$(database)/documents/assistantChats/$(chatId)).data.companyId, 'assistantChats');
        allow delete: if isSuperAdmin() ||
          isAdmin(get(/databases/$(database)/documents/assistantChats/$(chatId)).data.companyId);
      }
    }

    match /{collection}/{docId} {
      allow read: if collection != 'assistantChats' &&
        collection != 'users' &&
        collection != 'companyAccessRequests' &&
        collection != 'companyMembers' &&
        collection != 'deletionRequests' &&
        canReadCollection(resource.data.companyId, collection);

      allow create: if collection != 'assistantChats' &&
        collection != 'users' &&
        collection != 'companyAccessRequests' &&
        collection != 'companyMembers' &&
        collection != 'deletionRequests' &&
        request.resource.data.companyId is string &&
        canWriteCollection(request.resource.data.companyId, collection);

      allow update: if collection != 'assistantChats' &&
        collection != 'users' &&
        collection != 'companyAccessRequests' &&
        collection != 'companyMembers' &&
        collection != 'deletionRequests' &&
        resource.data.companyId is string &&
        request.resource.data.companyId == resource.data.companyId &&
        canWriteCollection(resource.data.companyId, collection);

      allow delete: if collection != 'assistantChats' &&
        collection != 'users' &&
        collection != 'companyAccessRequests' &&
        collection != 'companyMembers' &&
        collection != 'deletionRequests' &&
        (isSuperAdmin() || isAdmin(resource.data.companyId));
    }

    match /contactMessages/{messageId} {
      allow create: if request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 3 &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 5000;
      allow read: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /counters/{companyId} {
      allow read: if canReadCollection(companyId, 'counters');
      allow write: if canWriteCollection(companyId, 'counters');
    }
  }
}